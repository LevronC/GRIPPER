# ────────────────────────────────────────────────────────────────
# GRIPPER — Backend environment variables
# Copy this file to .env and fill in the values before running.
# NEVER commit .env to version control.
# ────────────────────────────────────────────────────────────────

# development | test | production   (defaults to production on Vercel)
ENVIRONMENT=development

# ── Database ─────────────────────────────────────────────────────
# Runtime connection used by the API and worker. MUST be the restricted login
# role created by scripts/create_app_role.py (NOSUPERUSER, NOBYPASSRLS, not the
# table owner). See docs/DATABASE_SECURITY.md.
DATABASE_URL=postgresql://gripper_app:change-me@localhost:5432/gripper

# Owner connection for `alembic upgrade head` and admin scripts ONLY.
# Never used by request handlers. (SUPERUSER_DATABASE_URL is a deprecated alias.)
MIGRATION_DATABASE_URL=postgresql://postgres:postgres@localhost:5432/gripper

# Run migrations on API start (requires MIGRATION_DATABASE_URL). Off by default;
# prefer running `alembic upgrade head` as a deploy step.
AUTO_MIGRATE=false

# enforce (default, required in production) | warn
DB_ROLE_SAFETY=enforce

# ── Redis ─────────────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379/0

# ── Authentication ────────────────────────────────────────────────
# REQUIRED, at least 32 characters. Generate with:
#   python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=

# ── Vercel Blob Storage ───────────────────────────────────────────
BLOB_READ_WRITE_TOKEN=

# ── Embeddings ────────────────────────────────────────────────────
HF_API_KEY=

# ── Operator-triggered ingestion (/cron/process-documents) ────────
CRON_SECRET=

# ── Development helpers ────────────────────────────────────────────
DEBUG_PRINT_CODES=false
SEED_DEMO_USER=false

# CORS — comma-separated list of allowed frontend origins
ALLOWED_ORIGINS=http://localhost:5173

# ────────────────────────────────────────────────────────────────
# GRIPPER — Backend environment variables
# Copy this file to .env and fill in the values before running.
# NEVER commit .env to version control.
# ────────────────────────────────────────────────────────────────

# ── Database ─────────────────────────────────────────────────────
# Vercel: use Vercel Postgres (Neon) connection string
# Local:  postgresql://user:password@localhost:5432/gripper
DATABASE_URL=postgresql://gripper_app:gripper_secure@localhost:5432/gripper

# Superuser connection used for auth lookups (bypasses RLS)
# On Vercel Postgres / Neon this can be the same pooled URL
SUPERUSER_DATABASE_URL=postgresql://postgres:postgres@localhost:5432/gripper

# ── Redis ─────────────────────────────────────────────────────────
# Vercel: use Upstash Redis — copy the rediss:// URL from Upstash dashboard
# Local:  redis://localhost:6379/0
REDIS_URL=redis://localhost:6379/0

# ── Authentication ────────────────────────────────────────────────
# REQUIRED — Generate with:
#   python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=

# ── Vercel Blob Storage ───────────────────────────────────────────
# Required on Vercel for PDF uploads (replaces local disk).
# Create a Blob store in Vercel dashboard → Storage → Blob,
# then copy the BLOB_READ_WRITE_TOKEN here.
BLOB_READ_WRITE_TOKEN=

# ── Embeddings ────────────────────────────────────────────────────
# Required on Vercel for real semantic search (sentence-transformers
# cannot load its 130MB model in a serverless function).
# Get a free key at https://huggingface.co/settings/tokens
# The BAAI/bge-small-en-v1.5 model is used automatically.
# Leave blank to use local sentence-transformers (dev only).
HF_API_KEY=

# ── Vercel Cron ───────────────────────────────────────────────────
# Secures the /api/cron/process-documents endpoint from public invocations.
# Set this in Vercel dashboard → Settings → Environment Variables.
# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
CRON_SECRET=

# ── Development helpers ────────────────────────────────────────────
# Print OTP / password-reset codes to the backend log.
# Set to "true" ONLY in local development — never in production.
DEBUG_PRINT_CODES=false

# Pre-seed a demo user on first boot (useful for local testing)
SEED_DEMO_USER=true

# Allow X-Institution-ID header auth (for scripts/tests — disable in production)
ALLOW_HEADER_AUTH=false

# CORS — comma-separated list of allowed frontend origins
ALLOWED_ORIGINS=http://localhost:5173

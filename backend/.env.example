# ────────────────────────────────────────────────────────────────
# GRIPPER — Backend environment variables
# Copy this file to .env and fill in the values before running.
# NEVER commit .env to version control.
# ────────────────────────────────────────────────────────────────

# development | test | production   (defaults to production on Vercel)
ENVIRONMENT=development

# ── Database ─────────────────────────────────────────────────────
# Runtime connection used by the API and worker. MUST be the restricted login
# role created by scripts/create_app_role.py (NOSUPERUSER, NOBYPASSRLS, not the
# table owner). See docs/DATABASE_SECURITY.md.
DATABASE_URL=postgresql://gripper_app:change-me@localhost:5432/gripper

# Owner connection for `alembic upgrade head` and admin scripts ONLY.
# Never used by request handlers. (SUPERUSER_DATABASE_URL is a deprecated alias.)
MIGRATION_DATABASE_URL=postgresql://postgres:postgres@localhost:5432/gripper

# Run migrations on API start (requires MIGRATION_DATABASE_URL). Off by default;
# prefer running `alembic upgrade head` as a deploy step.
AUTO_MIGRATE=false

# enforce (default, required in production) | warn
DB_ROLE_SAFETY=enforce

# ── Redis ─────────────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379/0

# ── Authentication ────────────────────────────────────────────────
# REQUIRED, at least 32 characters. Generate with:
#   python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=

# ── Vercel Blob Storage ───────────────────────────────────────────
BLOB_READ_WRITE_TOKEN=

# ── Embeddings ────────────────────────────────────────────────────
# auto (default): hf_api if HF_API_KEY is set, else local if sentence-transformers is
# installed (not on Vercel), else none. none = full-text search only.
# There is no silent fallback; see docs/DEPLOYMENT_NOTES.md.
EMBEDDING_PROVIDER=auto
HF_API_KEY=

# ── Ingestion ─────────────────────────────────────────────────────
# auto (default): queue when Redis is reachable and a worker can exist; on Vercel,
# sync unless INGESTION_WORKER=external declares a worker consuming the same Redis.
INGESTION_MODE=auto
INGESTION_WORKER=

# ── Operator-triggered ingestion (/cron/process-documents) ────────
CRON_SECRET=

# ── Explanations (optional SubQ Savant) ──────────────────────────
# none (default): deterministic rule-based explanations. No external call.
# subq: SubQ Savant, and only when BOTH of the following are true:
#   LLM_EXTERNAL_PROCESSING_ENABLED=true
#   the institution row external_processing_authorized=true
#       (scripts/set_external_processing.py; the API cannot set it)
# The base URL is accepted only when it is https://api.subq.ai/v1.
# Do not put a real key in this file. See docs/LLM.md.
LLM_PROVIDER=none
LLM_EXTERNAL_PROCESSING_ENABLED=false
SUBQ_API_KEY=
SUBQ_BASE_URL=https://api.subq.ai/v1
SUBQ_MODEL=subq-savant-1.4
LLM_TIMEOUT_SECONDS=15
LLM_MAX_OUTPUT_TOKENS=500
LLM_MAX_RETRIES=1

# ── Email (invitations, password reset) ──────────────────────────
# disabled (default): invitation and reset endpoints return 503; no token is ever
#                     returned or logged as a fallback.
# smtp: real delivery. For local dev use the docker compose `mailpit` service:
#       SMTP_HOST=localhost SMTP_PORT=1025 SMTP_STARTTLS=false, UI at http://localhost:8025
EMAIL_BACKEND=disabled
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_STARTTLS=true
EMAIL_FROM=Gripper <no-reply@example.com>
# Base URL of the frontend, used to build invitation / reset links.
APP_BASE_URL=http://localhost:5173

# ── Development helpers ────────────────────────────────────────────
# Include exception text in 500 responses (refused when ENVIRONMENT=production).
DEBUG_ERRORS=false

# CORS — comma-separated list of allowed frontend origins
ALLOWED_ORIGINS=http://localhost:5173
